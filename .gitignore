# ============================================================
# .gitignore — CHIRPS V3.0 Paramétrico
# ============================================================

# Dados NetCDF (arquivos grandes — armazenados no disco Render)
data/
*.nc
*.nc4

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Logs
*.log
logs/

# Credenciais e configuração local
.env
.env.*
credentials/
*.json
!package.json

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testes
.pytest_cache/
htmlcov/
.coverage

# Outputs temporários
output/
tmp/
temp/

# Dados CHIRPS - TIFs diários (grandes demais para git)
data/chirps_v3/tifs/
data/chirps_v3/2026/chirps-v3.0.rnl.2026.days_p05.nc

# Manter o NetCDF de período da apólice (pequeno - 2.8MB)
!data/chirps_v3/chirps-v3.0.rnl.policy_RS_2025-12-01_2026-02-15.nc
